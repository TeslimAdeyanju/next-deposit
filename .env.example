# Trading 212 API credentials: app → Settings → API → Generate key pair.
# Read-only permissions (account, portfolio, history, pies, metadata) are enough;
# this dashboard never places orders.
TRADING212_API_KEY=your_api_key_here
TRADING212_API_SECRET=your_api_secret_here

# Optional
# TRADING212_BASE_URL=https://demo.trading212.com/api/v0   # paper-trading account
# REFRESH_SECONDS=30                                        # live data refresh interval

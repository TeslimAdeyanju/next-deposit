# Broker API credentials, generated in the broker app (Settings → API).
# Use read-only permissions: Next Deposit never places orders.
# The broker's API terms allow personal use only; check them before use.
BROKER_API_KEY=your_api_key_here
BROKER_API_SECRET=your_api_secret_here
BROKER_BASE_URL=https://<broker-api-host>/api/v0   # live or demo endpoint from the broker's API docs

# Optional
# REFRESH_SECONDS=30                                    # live data refresh interval
